# =============================================================================
# AgentScope DashScope 演示 - 配置文件
# =============================================================================
# 所有配置项均有说明，按需修改即可。
# API Key 优先级：本文件 api_key 字段 > 环境变量 DASHSCOPE_API_KEY
# =============================================================================

# -----------------------------------------------------------------------------
# 模型配置
# -----------------------------------------------------------------------------
model:
  # DashScope 模型名称，常用选项：
  #   qwen-max        - 通义千问旗舰版（均衡性能与成本）
  #   qwen-plus       - 通义千问增强版
  #   qwen-turbo      - 通义千问快速版（速度最快、成本最低）
  #   qwen-long       - 通义千问长文档版（支持超长上下文）
  #   qwen2.5-72b-instruct  - Qwen2.5 开源版
  #   qwq-32b         - QwQ 深度思考版（需配合 enable_thinking: true）
  model_name: "qwen-max"

  # DashScope API Key
  # 留空则自动读取环境变量 DASHSCOPE_API_KEY
  # 强烈建议使用环境变量而非在此处填写明文 Key
  api_key: ""

  # 是否启用流式输出（true 推荐，实时逐 token 显示回复）
  stream: true

  # 是否启用深度思考模式
  # 仅支持 Qwen3、QwQ、DeepSeek-R1 系列模型
  # 启用时 stream 会自动设为 true
  enable_thinking: false

  # 是否启用多模态模式（处理图片、视频等输入）
  # null（留空）= 根据模型名称自动判断（带 -vl 后缀或 qvq 开头的模型自动启用）
  # true  = 强制使用 MultiModalConversation API
  # false = 强制使用 Generation API（纯文本）
  multimodality:

  # 模型生成参数，直接透传给 DashScope API
  generate_kwargs:
    # 采样温度：0.0（确定性）~ 2.0（高随机性），推荐 0.6~1.0
    temperature: 0.7
    # 核采样概率阈值：0.0~1.0，与 temperature 配合使用
    top_p: 0.9
    # 最大输出 token 数（注释掉则使用模型默认值）
    # max_tokens: 2048

  # DashScope API 基础 URL（如无特殊需求保持注释状态）
  # base_http_api_url: "https://dashscope.aliyuncs.com/api/v1"

# -----------------------------------------------------------------------------
# Agent 配置
# -----------------------------------------------------------------------------
agent:
  # Agent 名称，显示在对话界面中
  name: "Friday"

  # 系统提示词，定义 Agent 的角色和行为规范
  sys_prompt: |
    你是一个名叫 Friday 的智能助手，由 AgentScope 和 DashScope 驱动。
    你善于回答问题、编写代码、分析问题。
    请用简洁清晰的语言回复，并在合适时使用 Markdown 格式。

  # ReActAgent 最大迭代次数（工具调用循环的上限）
  max_iters: 10

  # 工具配置
  tools:
    # 是否启用内置工具（false = 纯对话模式，不使用任何工具）
    enabled: true
    # 要注册的工具函数列表，可按需增减
    # 可用工具：execute_shell_command, execute_python_code, view_text_file
    functions:
      - execute_shell_command   # 执行 Shell 命令
      - execute_python_code     # 执行 Python 代码片段
      - view_text_file          # 查看文本文件内容

# -----------------------------------------------------------------------------
# TUI（终端用户界面）配置
# -----------------------------------------------------------------------------
tui:
  # 启动时显示的欢迎语
  welcome_message: "欢迎使用 AgentScope × DashScope 演示！输入 'exit' 或按 Ctrl+C 退出。"

  # 退出时显示的告别语
  goodbye_message: "感谢使用，再见！"

  # 用户消息的颜色（rich 颜色名称或十六进制，如 cyan / #00ffff）
  user_color: "cyan"

  # Agent 回复的颜色
  agent_color: "green"

  # 思考过程（thinking block）的颜色
  thinking_color: "dim yellow"

  # 工具调用信息的颜色
  tool_color: "magenta"

  # 退出命令关键词列表（大小写不敏感）
  exit_commands:
    - "exit"
    - "quit"
    - "q"
    - "退出"
    - "bye"
